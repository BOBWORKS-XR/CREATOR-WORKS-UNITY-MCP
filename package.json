{
  "name": "creator-works-mcp",
  "version": "2.7.0-alpha.1",
  "description": "Codex, Claude Code, Antigravity, OpenCode, and MCP-compatible Unity integration with first-class Creator SDK and Banter knowledge",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle:server": "npm run build && esbuild dist/index.js --bundle --platform=node --format=esm --target=node20 --outfile=release/creator-works-mcp.mjs",
    "stage:runtime": "node scripts/stage-node-runtime.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "test:bundle": "node scripts/smoke-release-bundle.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "release:server": "npm run bundle:server && npm run test:bundle",
    "release:launcher": "npm run release:server && npm run stage:runtime",
    "test": "npm run build && node --test test/*.test.mjs",
    "measure:context": "npm run build && node scripts/measure-mcp-context.mjs",
    "smoke:unity:banter:vs": "node scripts/smoke-unity-banter-vs.mjs",
    "smoke:unity:banter:matrix": "node scripts/smoke-unity-banter-matrix.mjs",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js"
  },
  "keywords": [
    "mcp",
    "creator-works",
    "creator-sdk",
    "sidequest",
    "banter",
    "unity",
    "visual-scripting",
    "vr"
  ],
  "author": "Creator Works",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.4.0"
  }
}
